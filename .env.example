# Public Leseno app URL (auth redirects). Never use localhost on production Coolify.
NEXT_PUBLIC_SITE_URL=https://your-leseno-host

# Supabase (Coolify self-hosted or cloud)
NEXT_PUBLIC_SUPABASE_URL=https://supabase-api.example.de
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Required for Auth Admin APIs (invite). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres for local migration scripts (optional)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@host:5432/postgres?sslmode=disable
